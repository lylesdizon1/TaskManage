# Voice satellite configuration. Copy to .env and fill in. .env is gitignored.
# The same file works on any Mac — nothing here is machine-specific.

# ── Aria backend ─────────────────────────────────────────────────────────
# Base URL of your Aria server (no trailing /api/voice/message — that's added).
ARIA_API_BASE=https://taskmanage-production-b1bd.up.railway.app
# A valid Aria JWT (30-day expiry). The satellite is a thin stateless client;
# all reasoning/memory/tools live server-side behind this token.
ARIA_JWT=

# ── ElevenLabs — the ONLY external account you need ───────────────────────
# One key powers BOTH speech-to-text (Scribe v2 Realtime) and text-to-speech
# (Flash v2.5). Get it at https://elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
# REQUIRED. The voice Aria speaks with. There is no fallback — an unset or wrong
# voice breaks the "sounds like Aria" guarantee, so startup fails if it's blank.
ELEVENLABS_VOICE_ID=
# Optional. TTS model. Defaults to the low-latency flash model. Anything else
# adds first-audio latency and the app warns about it.
# ELEVENLABS_MODEL=eleven_flash_v2_5
# Optional. STT model. Defaults to Scribe v2 Realtime.
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Optional. Only 'elevenlabs' is wired today.
# TTS_PROVIDER=elevenlabs

# ── Behaviour ─────────────────────────────────────────────────────────────
# auto | always_on | hotkey_only
#   auto (default): on AC or a desktop → always_on; on battery → hotkey_only.
#                   Re-evaluated live when you (un)plug power.
#   always_on:      wake word always listening.
#   hotkey_only:    wake word disabled; only the hotkey triggers capture.
# VOICE_MODE=auto

# Global push-to-talk hotkey (pynput syntax). Works in EVERY mode.
# VOICE_HOTKEY=<alt>+<space>
# hold (default): capture while held.  toggle: press to start, press to stop.
# VOICE_HOTKEY_MODE=hold

# Path to a custom openWakeWord "hey_aria" model. If unset, a bundled pretrained
# model is used as a stand-in (the wake phrase is NOT "Hey Aria" until you train
# one — see README).
# VOICE_WAKEWORD_MODEL=/absolute/path/to/hey_aria.onnx

# Hard cap on a single utterance (seconds). Safety net; Scribe's VAD normally
# ends speech sooner. 1–60, default 15.
# MAX_UTTERANCE_SECONDS=15

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
# VOICE_LOG_LEVEL=INFO
